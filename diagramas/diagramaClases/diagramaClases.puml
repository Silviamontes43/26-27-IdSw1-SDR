@startuml
title Diagrama de Clases - Actividades Extracurriculares UNEATLÁNTICO

skinparam classAttributeIconSize 0
hide empty methods

enum EstadoAsistencia {
  PRESENTE
  FALTA_JUSTIFICADA
  FALTA_INJUSTIFICADA
}

enum TipoSolicitud {
  CONVALIDACION_OPTATIVA
  ACREDITACION_HISTORIAL
}

enum EstadoSolicitud {
  PENDIENTE
  ACEPTADA
  RECHAZADA
}

abstract class Usuario {
  # nombreCompleto : String
  # correoInstitucional : String
}

class Secretario {
  + crearActividad(actividad : Actividad, organizador : Organizador) : void
  + eliminarActividad(actividad : Actividad) : void
  + resolverSolicitud(solicitud : Solicitud, aceptada : boolean) : void
}

class Organizador {
  + anadirParticipante(actividad : Actividad, alumno : Alumno, rol : RolParticipacion) : Participacion
  + registrarAsistencia(participacion : Participacion, fecha : Date, estado : EstadoAsistencia) : void
  + cerrarActividad(actividad : Actividad) : void
}

class Alumno {
  - expediente : String
  - creditosDisponibles : double
  - creditosCanjeados : double
  + consultarHistorial() : List<Participacion>
  + crearSolicitud(tipo : TipoSolicitud, creditos : double) : Solicitud
}

class Ambito {
  - nombre : String
  - maxCreditos : double
}

class Actividad {
  - nombre : String
  - descripcion : String
  - departamento : String
  - cursoAcademico : String
  - cerrada : boolean
  + cerrar() : void
}

class RolParticipacion {
  - nombre : String
  - creditos : double
  - asistenciaMinima : double
  - horasMinimas : double
  + cumpleRequisitos(asistencia : double, horas : double) : boolean
}

class Participacion {
  - horasRealizadas : double
  - creditosObtenidos : double
  - superada : boolean
  - codigoDiploma : String
  + evaluar() : void
  + emitirDiploma() : String
}

class Asistencia {
  - fecha : Date
  - estado : EstadoAsistencia
  - justificante : String
  + justificarFalta(justificante : String) : void
}

class Solicitud {
  - fecha : Date
  - tipo : TipoSolicitud
  - creditosSolicitados : double
  - estado : EstadoSolicitud
  - observaciones : String
  + aceptar() : void
  + rechazar(motivo : String) : void
}

' Herencia
Usuario <|-- Secretario
Usuario <|-- Organizador
Usuario <|-- Alumno

' Asociaciones
Ambito "1" o-- "0..*" Actividad : clasifica >
Secretario "1..*" -- "0..*" Actividad : administra >
Organizador "1" -- "0..*" Actividad : gestiona >

Actividad "1" *-- "1..*" RolParticipacion : define >
Actividad "1" -- "0..*" Participacion : incluye >
Alumno "1" -- "0..*" Participacion : realiza >
RolParticipacion "1" -- "0..*" Participacion : asigna >

Participacion "1" *-- "0..*" Asistencia : registra >

Alumno "1" -- "0..*" Solicitud : presenta >
Secretario "0..1" -- "0..*" Solicitud : resuelve >

' Dependencias con enumeraciones
Asistencia ..> EstadoAsistencia
Solicitud ..> TipoSolicitud
Solicitud ..> EstadoSolicitud

@enduml
